#!/bin/sh /etc/rc.common
# OpenWrt procd init script for lotsmand (NanoPi R5S).
#
# Install on the router:
#   cp examples/lotsmand.init /etc/init.d/lotsmand
#   chmod +x /etc/init.d/lotsmand
#   cp examples/lotsmand.env  /opt/lotsman/lotsmand.env   # edit flags here
#   /etc/init.d/lotsmand enable
#   /etc/init.d/lotsmand start
#   logread -e lotsmand -f                                # watch decisions
#
# It runs the autonomous mutator 24/7: lotsmand switches nfqws strategy and
# Clash selectors on its own. Start with LOTSMAND_DRYRUN=1 in the env file to
# observe decisions without changing anything, then flip to 0 once trusted.

USE_PROCD=1
# Start late: needs network up and sing-box's clash-api + socks inbound ready.
START=95
STOP=10

PROG=/opt/lotsman/lotsmand
ENV_FILE=/opt/lotsman/lotsmand.env

start_service() {
	# Defaults; overridden by /opt/lotsman/lotsmand.env if present.
	LOTSMAND_CONFIG=/opt/lotsman/config.yaml
	LOTSMAND_DRYRUN=1
	LOTSMAND_SMART=1
	LOTSMAND_INTERVAL=30s
	LOTSMAND_CHECK_INTERVAL=10m
	LOTSMAND_CLASH_BASE=http://127.0.0.1:9090
	LOTSMAND_PROBE_PROXY=127.0.0.1:7891
	LOTSMAND_VPN_SELECTOR=vpn
	LOTSMAND_METRICS_ADDR=127.0.0.1:9101
	LOTSMAND_AUDIT_LOG=/opt/lotsman/transitions.jsonl
	LOTSMAND_FAIL_LOG=/opt/lotsman/fails.jsonl
	LOTSMAND_EXTRA=

	[ -f "$ENV_FILE" ] && . "$ENV_FILE"

	procd_open_instance
	procd_set_param command "$PROG" \
		-config="$LOTSMAND_CONFIG" \
		-dry-run="$LOTSMAND_DRYRUN" \
		-smart="$LOTSMAND_SMART" \
		-interval="$LOTSMAND_INTERVAL" \
		-check-interval="$LOTSMAND_CHECK_INTERVAL" \
		-clash-base="$LOTSMAND_CLASH_BASE" \
		-probe-proxy="$LOTSMAND_PROBE_PROXY" \
		-vpn-selector="$LOTSMAND_VPN_SELECTOR" \
		-metrics-addr="$LOTSMAND_METRICS_ADDR" \
		-audit-log="$LOTSMAND_AUDIT_LOG" \
		-fail-log="$LOTSMAND_FAIL_LOG" \
		$LOTSMAND_EXTRA

	# Restart on crash, but back off so a broken config can't crash-loop:
	# if it dies 5 times within 3600s, give up until the next manual start.
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1   # route logs to logd (logread)
	procd_set_param stderr 1
	procd_close_instance
}
