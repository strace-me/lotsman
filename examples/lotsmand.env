# Flag overrides for /etc/init.d/lotsmand. Copy to /opt/lotsman/lotsmand.env
# and edit. Anything not set here uses the defaults baked into the init script.

# Start in observe-only mode (log decisions, change nothing). Flip to 0 once you
# trust what it wants to do.
LOTSMAND_DRYRUN=1

# LOTSMAND_CONFIG=/opt/lotsman/config.yaml
# LOTSMAND_SMART=1
# LOTSMAND_INTERVAL=30s
# LOTSMAND_CHECK_INTERVAL=10m
# LOTSMAND_CLASH_BASE=http://127.0.0.1:9090
# LOTSMAND_PROBE_PROXY=127.0.0.1:7891
# LOTSMAND_VPN_SELECTOR=vpn
# LOTSMAND_METRICS_ADDR=127.0.0.1:9101
# LOTSMAND_AUDIT_LOG=/opt/lotsman/transitions.jsonl
# LOTSMAND_FAIL_LOG=/opt/lotsman/fails.jsonl

# Any extra raw flags (e.g. -zapret-script-dir=...):
# LOTSMAND_EXTRA=
