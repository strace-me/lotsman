# systemd unit for the Lotsman desktop client (Linux).
#
# Install:
#   sudo install -m0755 lotsman /usr/local/bin/lotsman
#   sudo install -Dm0644 examples/lotsman.service /etc/systemd/system/lotsman.service
#   sudo install -Dm0644 examples/lotsman.env     /etc/lotsman/client.env   # edit flags here
#   sudo install -Dm0600 your-config.yaml                /etc/lotsman/client.yaml
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now lotsman
#   journalctl -u lotsman -f                       # watch it steer
#
# This is the privileged half of shape B: the service owns the tun and the
# NFQUEUE desync (both need CAP_NET_ADMIN/CAP_NET_RAW) and the brain owns the
# decisions. The control socket lives at /run/lotsman/control.sock.
#
# UNPRIVILEGED UI: the socket is the privilege seam, so it defaults to owner-only
# 0600. To let an unprivileged GUI/tray drive this root service, put both in a
# shared group:
#   sudo groupadd --system lotsman
#   sudo usermod -aG lotsman <your-login>      # log out/in for it to take effect
# then Group=lotsman + RuntimeDirectoryMode=0750 below make /run/lotsman
# group-traversable, and -control-socket-group lotsman makes the socket 0660
# root:lotsman — a member of the group can attach without being root. To also
# let the GUI start/stop this unit without a password, install the polkit rule:
#   sudo install -Dm0644 examples/lotsman.rules \
#        /etc/polkit-1/rules.d/49-lotsman.rules
#
# DAILY DRIVER (replace the system sing-box): this service and a system sing-box
# cannot both own a tun. Disable the system unit before enabling this one —
#   sudo systemctl disable --now sing-box
# — and put the tun-mode flags (no -proxy; -zapret-files; -wan) in the env file.

[Unit]
Description=Lotsman desktop client (autonomous anti-censorship tunnel)
Documentation=https://github.com/strace-me/lotsman
# The client needs sing-box's Clash-API up, which it starts itself, but it also
# needs the network to exist first.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/lotsman/client.env
# The service runs as root (tun + NFQUEUE need it); Group=lotsman is the shared
# group an unprivileged UI joins to reach the control socket. Comment both this
# and -control-socket-group out to keep the socket owner-only 0600.
Group=lotsman
# The flags live in the env file so an upgrade of the unit does not clobber local
# choices; the defaults there are a working starting point.
ExecStart=/usr/local/bin/lotsman \
	-config ${LOTSMAN_CONFIG} \
	-state-file ${LOTSMAN_STATE_DIR}/state.json \
	-kb-file ${LOTSMAN_STATE_DIR}/kb.json \
	-singbox-config ${LOTSMAN_STATE_DIR}/singbox.json \
	-control-socket ${LOTSMAN_RUNTIME_DIR}/control.sock \
	-control-socket-group lotsman \
	-metrics-addr ${LOTSMAN_METRICS_ADDR} \
	$LOTSMAN_EXTRA
# NB $LOTSMAN_EXTRA is deliberately UNBRACED: only the bare $VAR form splits on
# whitespace into separate argv words. ${LOTSMAN_EXTRA} would pass the whole
# string as ONE argument, and lotsman would reject it and crash-loop.

# /run/lotsman for the control socket, /var/lib/lotsman for KB/state/baseline and
# the nfqws hostlists — systemd creates and owns both. RuntimeDirectoryMode=0750
# (paired with Group=lotsman) lets a group member traverse to the socket; drop it
# back to 0700 if you remove the group.
RuntimeDirectory=lotsman
RuntimeDirectoryMode=0750
# Survives a restart because it holds the crash-safe copy of the host's original
# resolv.conf (-host-dns). Wiping it on every restart means an unclean death loses the
# only record of what DNS looked like before the redirect — and then nothing can put
# it back: the next start reads our own sentinel as if it were the real resolver.
RuntimeDirectoryPreserve=restart
StateDirectory=lotsman
StateDirectoryMode=0700

# tun + NFQUEUE are the only things needing privilege; keep just those two caps.
# nfqws drops its own privileges after binding the queue, so this is the ceiling,
# not what the desync runs as day to day.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

# Restart on crash, but back off so a broken config cannot crash-loop the machine:
# five deaths inside 60s trips the limit and systemd stops trying until told to.
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
