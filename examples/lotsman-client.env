# Flags for lotsman-client, read by the systemd unit. Edit here rather than the
# unit so an upgrade does not overwrite your choices.

# The config the client loads (services, subscriptions, pools, chains). Keep it
# 0600 — it holds node credentials and the sing-box config it generates does too.
LOTSMAN_CONFIG=/etc/lotsman/client.yaml

# systemd sets these to /var/lib/lotsman and /run/lotsman via StateDirectory /
# RuntimeDirectory; the unit passes them on. Override only if you know why.
LOTSMAN_STATE_DIR=/var/lib/lotsman
LOTSMAN_RUNTIME_DIR=/run/lotsman

# Serve Prometheus /metrics on loopback (per-service position/state/broken/fails,
# KB EWMA, and the passive observe eye's frozen/leak/one-way ratios). Empty to
# turn both the endpoint and the observe pass off.
LOTSMAN_METRICS_ADDR=127.0.0.1:9091

# Extra flags, appended verbatim. Common ones:
#   -proxy 127.0.0.1:1080         run in PROXY mode (no tun, no root) to try a config
#   -refresh-interval 5m          re-fetch subscriptions and reconcile
#   -zapret-files /var/lib/lotsman/zapret   dir of nfqws fake-payload .bin files
#   -desync-exclude 10.0.0.0/24   servers of another VPN sharing this host
LOTSMAN_EXTRA=
