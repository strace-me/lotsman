# build artifacts
/bin/
/lotsmand
/lotsmanctl
/lotsman
*.elf
*.bin
# ...except the desync fake payloads, which are DATA, not build output: recorded
# packets nixpkgs does not ship, and 11 recipes are useless without them. The blanket
# *.bin above silently swallowed them once already — the commit went through with only
# the README, describing files that were not there.
!assets/zapret-payloads/*.bin

# user data (lives in /etc/lotsman/, never in repo)
/etc/
*.db
*.db-*

# editor/OS
.DS_Store
*.swp

# agent worktrees (ephemeral)
.claude/worktrees/

# coverage / scratch artifacts (must not ship)
cover.out
*.out
# stray office docs + their lock files
*.docx
~$*

# installed third-party agent skills (reproducible via npx, must not ship to public)
.claude/skills/
.agents/
/dist/

# The owner's own working material lives in this directory and must never be
# committed: the repo is headed for a GPLv3 release and git history survives a
# `git rm`. On 2026-08-07 a bare `git add -A` swept 33 of these files — BMC
# screenshots, FRU dumps, a hardware certification protocol — into a pushed
# commit, and the history had to be rewritten to get them out. Second time in one
# day; the first is recorded in the CHANGELOG against cfb2154.
biosbmctests/
A-650*
PRERELEASE-AUDIT-*.md
Протокол испытаний*
private/
skills-lock.json

# Build outputs that land in the repo root
/desktop
/desktop.exe
/lotsmand

# Build outputs that land next to their source
/client/desktop/desktop
/client/gui/gui
/tmp/

# Сохранённые бинари для отката, по одному каталогу на версию. Живут здесь, а не
# в корне домашнего каталога, где их накопилось 25 штук на 417 МБ. Восстанавливаются
# из git через scripts/build.sh, так что терять их не страшно — но `git clean -xdf`
# сносит и игнорируемое, а значит снесёт и их.
/rollbacks/

# Рабочий артеФилтер: plaintext-секреты (old-значения) для --replace-text.
# Каноника живёт в /tmp/opencode/replace-text-scrub; в репо не коммитить.
/.replace-text-scrub
.claude/
