# Flowseal ALT12 — run VERBATIM, one argument per line.
#
# Point a config at it and Lotsman composes nothing:
#
#   zapret:
#     preset:
#       name: ALT12
#       args_file: /var/lib/lotsman-presets/alt12.args
#
# WHY THIS FILE EXISTS. ALT12 is one nfqws launch whose profiles carry DIFFERENT
# hostlists — the narrow tcp/443 Google treatment against list-google, the broad
# one against list-general. Lotsman composes per RULE with one hostlist per rule,
# so both profiles receive the same list, the second can never match, and the
# recipe is refused as self-shadowing. That refusal is correct about what we would
# have rendered and says nothing about ALT12: a nine-profile bundle taken apart
# into one profile per rule is a different strategy under the same name.
#
# WHAT IT NEEDS ON DISK. The lists below are Flowseal's own, fetched by the
# `hostlists:` packs. `flowseal-google` and `flowseal-exclude` are usually already
# declared; add the others:
#
#   hostlists:
#     - name: flowseal-general
#       out: /var/lib/lotsman-hostlists/packs/flowseal-general.txt
#       sources: ["https://raw.githubusercontent.com/Flowseal/zapret-discord-youtube/main/lists/list-general.txt"]
#       min_keep_ratio: 0.5
#
# Payload .bin names resolve against the zapret files dir, as they do for a
# composed strategy, so they stay bare here.
#
# WHAT THE MODE COSTS, so nobody rediscovers it: per-rule recipe learning stops —
# one bundle serves every rule and there is nothing left to choose between. The
# rungs still work: a rule on its desync rung routes DIRECT and meets the preset,
# a rule on VPN is tunnelled and never reaches it, and the canary still judges
# each rule on its own volume, so a preset that stops carrying still escalates the
# rules it was carrying.
#
# VERIFY IT IS ACTUALLY RUNNING: the log says
#   "zapret: preset applied verbatim, nothing composed" preset=ALT12
# and /status shows ALT12 as the strategy for every rule on a desync rung. If you
# see composed recipe ids instead, the preset did not load.

# --- profile 1: Google properties, narrow to tcp/443 ------------------------
--filter-tcp=443
--hostlist=/var/lib/lotsman-hostlists/packs/flowseal-google.txt
--hostlist-exclude=/var/lib/lotsman-hostlists/packs/flowseal-exclude.txt
--ip-id=zero
--dpi-desync=hostfakesplit
--dpi-desync-fooling=ts
--dpi-desync-hostfakesplit-mod=host=www.google.com

# --- profile 2: everything else over TLS ------------------------------------
--new
--filter-tcp=80,443
--hostlist=/var/lib/lotsman-hostlists/packs/flowseal-general.txt
--hostlist-exclude=/var/lib/lotsman-hostlists/packs/flowseal-exclude.txt
--dpi-desync=fake,multisplit
--dpi-desync-split-seqovl=664
--dpi-desync-split-pos=1
--dpi-desync-fooling=ts
--dpi-desync-repeats=8
--dpi-desync-split-seqovl-pattern=tls_clienthello_max_ru.bin
--dpi-desync-fake-tls=stun.bin
--dpi-desync-fake-tls=tls_clienthello_max_ru.bin
--dpi-desync-fake-http=tls_clienthello_max_ru.bin

# --- profile 3: QUIC --------------------------------------------------------
--new
--filter-udp=443
--hostlist=/var/lib/lotsman-hostlists/packs/flowseal-general.txt
--hostlist-exclude=/var/lib/lotsman-hostlists/packs/flowseal-exclude.txt
--dpi-desync=fake
--dpi-desync-repeats=11
--dpi-desync-fake-quic=quic_initial_www_google_com.bin

# --- profile 4: Discord voice — UDP carries no SNI, so it is matched by port -
--new
--filter-udp=19294-19344,50000-50100
--filter-l7=discord,stun
--dpi-desync=fake
--dpi-desync-fake-discord=stun.bin
--dpi-desync-fake-stun=stun.bin
--dpi-desync-repeats=3

# --- profile 5: discord.media on the alternate TLS ports --------------------
--new
--filter-tcp=2053,2083,2087,2096,8443
--hostlist=/var/lib/lotsman-hostlists/packs/flowseal-general.txt
--dpi-desync=fake,multisplit
--dpi-desync-split-seqovl=681
--dpi-desync-split-pos=1
--dpi-desync-fooling=ts
--dpi-desync-repeats=8
--dpi-desync-split-seqovl-pattern=tls_clienthello_www_google_com.bin
--dpi-desync-fake-tls=tls_clienthello_www_google_com.bin
